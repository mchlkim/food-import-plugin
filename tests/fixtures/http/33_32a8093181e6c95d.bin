		initEDotXPress('\uB300\uD55C\uBBFC\uAD6D\uACFC \uD0DC\uAD6D \uAC04 \uC218\uCD9C\u00B7\uC785 \uC218\uC0B0\uBB3C\u00B7\uC218\uC0B0\uC81C\uD488\uC758 \uD488\uC9C8\uAD00\uB9AC \uBC0F \uC704\uC0DD\uC548\uC804');
