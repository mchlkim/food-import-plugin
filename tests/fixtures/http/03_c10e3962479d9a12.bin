                            <div class="y2019">
                                <div class="timeline__head"><strong>2019</strong></div>
                                <div class="timeline__body">
                                    <div class="timeline__item point">
                                        <div class="timeline__right timeline__box">
                                            <p class="date"><span>4.11.</span></p>
                                            <ul class="timelist">
