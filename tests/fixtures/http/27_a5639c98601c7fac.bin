      <a name="J2798593"></a> 
      <div class="pgroup"> 
       <p class="pty3"> <img id="ar2798593btn" style="vertical-align: middle;" alt="부칙<제2026-76호, 2026. 7. 6.>조문목록 없음" src="/LSW/images/button/btn_dot.gif" /> <input type="checkbox" name="arInf" id="chk2798593" style="vertical-align: middle;" alt="부칙<제2026-76호, 2026. 7. 6.>체크박스" value="2798593" /> <a class="nun" onclick="javascript:arView('ar2798593', '<제2026-76호, 2026. 7. 6.>');return false;" href="#AJAX"> <label for="chk2798593"> <span class="bl">부      칙</span> </label> <span class="sfon">&lt;제2026-76호, 2026. 7. 6.&gt;</span> </a> </p> 
       <p class="pty3_dep1" style="margin-top: -10px;"> 이 고시는 2026년 7월 5일부터 시행한다. </p> 
       <!-- 부칙 조번호 --> 
