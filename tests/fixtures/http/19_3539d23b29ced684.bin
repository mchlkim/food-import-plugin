	<script>

		$(document).ready(function() {
			var authValue = "anonymousUser";
			if(authValue != "anonymousUser") {
				var tempValue = authValue.roles;
				var rolesValue = tempValue;

				/** 스크립트 오류 수정 */
				if(rolesValue!=null && rolesValue!=undefined){
					for (var i=0; i < rolesValue.length; i++){
						if(rolesValue[i] == "ROLE_NIMPW_BLOCKCHAIN") {
							$("#blockAuth").show();
							break;
						} else {
							$("#blockAuth").hide();
						}
					}
				}
			}

		});

		
		/** VALION START
		 * 밸리온소프트_KHS
		 * 등록된 업체와 위임관계에 있는 업체를 콤보박스로 변경 시
		 */
		function fnChangeUser () {
			var userInfo = $("#userInfoList").val();
			//$("#loginId").val(userInfo);
			var mberId = $("#mberId2").text();
			var str1 = $("#userInfoList option:selected").text();
			var getStr1 = str1.split('[');

			$("#trgetBssNm").val(getStr1[0]);
			$("#trgetBssLcsno").val(userInfo);
			$("#loginId").val(mberId);



			gfnAjaxSubmit({
				url : "\/CFFKK01F01\/changeMndt"
		, param : $("#frmMndt").serialize()
					, id : "change"
					, ajaxCallbackFn : fnMndtChangeCallback
		});
		}
		/** VALION END*/

		/** VALION START
		 * 밸리온소프트_KHS
		 * 위임업체 변경 콜백
		 */
		function fnMndtChangeCallback(id, result){
			if(id == "change"){
				location.href = "\/";
			}
			}
			/** VALION END*/

			
			function fnMndtLoginCallback(id, result) {

				
				if (id == "login") {
					
					if (result.resultCode == "success" || result.resultCode == "pwChange" || result.resultCode == "reAgreeAuth") {
						
						if ($("#idSave").is(":checked") == true) {
							
							gCookieUtil.set("saveId", $("#loginId").val());
						} else {
							gCookieUtil.del("saveId");
						}

						/** 비밀번호 변경 창 */
						if(result.message == '/CFFJJ01P01'){
							gfnPopup({
								id : "CFFJJ01P01"
								, url : encodeURI("\/CFFJJ01P01" + "?userId=" + $('#loginId').val())
									, width : "770px"
									, height : "480px"
									, left : window.screenX + (window.innerWidth/2 - 770/2) + "px"
						});

							/** 1.5초뒤 실행 : 세션 종료는 하지 않는 것으로 변경함. */
							//setTimeout(function(){ gfnLogout(); }, 1500);


						}else{
								location.href = "\/?success=Y" + "&userId=" + $('#loginId').val();
								//로그인 후 수입신고 진행상황으로 이동
								//location.href = "\/CFFAA02F01?success=Y" + "&userId=" + $('#loginId').val();

								//location.href = "\/radsafe?success=Y";
							}

							} else if (result.resultCode == "fail") {
								gfnAlert({content : "해당 아이디 및 비밀번호와<br/>일치하는 계정 없습니다."});
							} else if (result.resultCode == "pwFail") {
								var msg = "비밀번호 입력이 " + result.data + "회 틀렸습니다.";
								msg += "<br/>입력이 5회 틀릴 경우 계정이 잠깁니다.";
								gfnAlert({content : msg});
							} else if (result.resultCode == "failCountExceed") {
								gfnAlert({id : "failCountExceed"
									, content : "비밀번호 입력 5회 오류로 인해<br/>계정이 잠겼습니다.<br/>비밀번호 찾기 화면으로 이동되오니<br/>임시비밀번호를 발급 받으시기 바랍니다."});
							} else if (result.resultCode == "drmncyRelease") {
								gfnAlert({content : "휴면상태 계정입니다."});
							} else if (result.resultCode == "readyJoin") {
								gfnAlert({content : "아직 가입대기 상태입니다."});
							} else if (result.resultCode == "stopActivity") {
								gfnAlert({content : "활동정지된 상태입니다.<br/>1811-6496으로 문의 바랍니다."});
							} else {
								gfnAlert({content : "죄송합니다.<br/>예외 상황이 발생하였습니다."});
							}
						} else if(id == "passwordChange") {
							alert("나중에 변경 완료");
						}
					}

					function fnSetMybizMenu() {
						gfnPopup({
							id : "CFRDA06P01"
							, url : encodeURI("\/CFRDA06P01")
								, width : "845px"
								, height : "680px"
					});
					}

						function moveScreen(screenId){

							/** 통계화면 바로 가기 링크 */
							if ("CFDAA10F010" == screenId) {
								var isMobile = true;

								//전체
								gfnAjaxSubmit({
									url: '/cmmn/getSsoKey'
									, ajaxCallbackFn: function(id, result) {
										if('F' == result.msg_code ){
											if (result.profile == "local") {
												if (isMobile == true) {
													window.open('http://localhost:8850/ifs/websquare/websquare.html?w2xPath=/ifs/ui/indexMb.xml', 'impw_ifs');
												} else {
													window.open('http://localhost:8850/ifs/websquare/websquare.html?w2xPath=/ifs/ui/index.xml', 'impw_ifs');
												}
											} else if (result.profile == "dev") {


											} else {
												if (isMobile == true) {
													window.open('https://impfood.mfds.go.kr/ifs/websquare/websquare.html?w2xPath=/ifs/ui/indexMb.xml', 'impw_ifs');
												} else {
													window.open('https://impfood.mfds.go.kr/ifs/websquare/websquare.html?w2xPath=/ifs/ui/index.xml', 'impw_ifs');
												}
											}
										}else{
											if (result.profile == "local") {
												if (isMobile == true) {
													window.open('http://localhost:8850/ifs/websquare/websquare.html?w2xPath=/ifs/ui/indexMb.xml&ssoKey='+ result.ssoKey, 'impw_ifs');
												} else {
													window.open('http://localhost:8850/ifs/websquare/websquare.html?w2xPath=/ifs/ui/index.xml&ssoKey='+ result.ssoKey, 'impw_ifs');
												}
											} else if (result.profile == "dev") {

											} else {
												if (isMobile == true) {
													window.open('https://impfood.mfds.go.kr/ifs/websquare/websquare.html?w2xPath=/ifs/ui/indexMb.xml&ssoKey='+ result.ssoKey, 'impw_ifs');
												} else {
													window.open('https://impfood.mfds.go.kr/ifs/websquare/websquare.html?w2xPath=/ifs/ui/index.xml&ssoKey='+ result.ssoKey, 'impw_ifs');
												}
											}
										}
									}
								});
							}
						}

						/* 수입식품 관리번호 발급 누리집 이동 */
						function fnGoPrductMngno() {
							var authValue = "anonymousUser";
							if (authValue === "anonymousUser") {
								gfnAlert({
									titleAlertMsg: "로그인 필요",
									content: "로그인 후 이용할 수 있습니다. 로그인 페이지로 이동합니다.",
									alertCallbackFn: function () {
										location.href = "/CFFKK01F01?a=CFS";
									}
								});
							} else {
								location.href = "/CFS";
							}
						}
	</script>

