      {
        "topic": "general",
        "priority_class": 5,
        "when": {},
        "effective_from": "2026-09-30",
        "effective_to": null,
        "date_basis": "declaration",
        "id": "GEN-ART27-DECLARATION",
        "effect": "REQUIRE",
        "documents": [
          {
            "name": "수입식품등의 수입신고서(별지 제25호서식)",
            "category": "식약처 수입신고 기본 구비서류"
          }
        ],
        "legal_basis": [
          "수입식품안전관리 특별법 시행규칙 제27조제1항 각 호 외의 부분"
        ],
        "source": {
          "source_id": "law_enforcement_rule_27",
          "title": "수입식품안전관리 특별법 시행규칙 제27조(수입식품등의 수입신고)",
          "url": "https://www.law.go.kr/LSW/lsInfoP.do?lsiSeq=290799&efYd=20260930",
          "publication_date": null,
          "retrieved_at": "2026-11-10T10:13:26+09:00",
          "location": "제27조(수입식품등의 수입신고) 제1항 각 호 외의 부분",
          "quote": "제27조(수입식품등의 수입신고) ① 법 제20조 제1항 에 따라 수입신고를 하려는 자(수입식품등 인터넷 구매 대행업자는 제외한다)는 별지 제25호서식 의 수입식품등의 수입신고서에 다음 각 호의 서류(식품의약품안전처장이 인정하는 통신망을 통하여 수출국 정부기관에서 발급한 증명서로 확인할 수 있는 경우는 제외한다)를 첨부하여 수입식품등의 통관장소를 관할하는 지방식품의약품안전청장에게 제출해야 한다. 이 경우 수입식품등의 도착 예정일 5일 전부터 미리 신고할 수 있으며, 미리 신고한 도착항, 도착 예정일, 반입 장소 및 반입 예정일 등 주요 사항이 변경되는 경우에는 즉시 그 내용을 문서로 신고해야 한다. <개정 2018. 2. 9., 2018. 12. 20., 2019. 6. 19., 2019. 11. 18., 2022. 3. 2., 2022. 6. 30., 2022. 11. 25., 2024. 6. 14., 2026. 9. 30.>"
        }
      },
      {
        "topic": "general",
        "priority_class": 5,
        "when": {},
        "effective_from": "2026-09-30",
        "effective_to": null,
        "date_basis": "declaration",
        "id": "GEN-ART27-1-LABEL",
        "effect": "REQUIRE",
        "documents": [
          {
            "name": "한글표시가 된 포장지 또는 한글표시 내용이 적힌 서류",
            "category": "식약처 수입신고 기본 구비서류"
          }
        ],
        "condition_note": "",
        "legal_basis": [
          "수입식품안전관리 특별법 시행규칙 제27조제1항제1호"
        ],
        "source": {
          "source_id": "law_enforcement_rule_27",
          "title": "수입식품안전관리 특별법 시행규칙 제27조(수입식품등의 수입신고)",
          "url": "https://www.law.go.kr/LSW/lsInfoP.do?lsiSeq=290799&efYd=20260930",
          "publication_date": null,
          "retrieved_at": "2026-11-10T10:13:26+09:00",
          "location": "제27조(수입식품등의 수입신고) 제1항제1호",
          "quote": "한글표시가 된 포장지(한글표시가 인쇄된 스티커를 붙인 포장지를 포함한다) 또는 한글표시 내용이 적힌 서류"
        }
      },
      {
        "topic": "general",
        "priority_class": 5,
        "when": {},
        "effective_from": "2026-09-30",
        "effective_to": null,
        "date_basis": "declaration",
        "id": "GEN-ART27-1-2-PHOTO",
        "effect": "CONDITIONAL",
        "documents": [
          {
            "name": "수입식품등의 사진",
            "category": "조건부 제출서류"
          }
        ],
        "condition_note": "조문 단서(별표 9 제2호가목1)~3) 해당 식품, 식약처 홈페이지 게시 제외 식품)에 해당하면 내지 않는다.",
        "legal_basis": [
          "수입식품안전관리 특별법 시행규칙 제27조제1항제1의2호"
        ],
        "source": {
          "source_id": "law_enforcement_rule_27",
          "title": "수입식품안전관리 특별법 시행규칙 제27조(수입식품등의 수입신고)",
          "url": "https://www.law.go.kr/LSW/lsInfoP.do?lsiSeq=290799&efYd=20260930",
          "publication_date": null,
          "retrieved_at": "2026-11-10T10:13:26+09:00",
          "location": "제27조(수입식품등의 수입신고) 제1항제1의2호",
          "quote": "수입식품등의 사진(한글 표시사항, 수출국 표시사항 등 주요 정보를 확인할 수 있는 천연색 사진을 말한다). 다만, 다음 각 목의 어느 하나에 해당하는 수입식품등은 제외한다. 가. 별표 9 제2호가목1)부터 3)까지의 어느 하나에 해당하는 수입식품등 나. 그 밖에 식품의약품안전처장이 정하여 식품의약품안전처의 인터넷 홈페이지에 게시하는 수입식품등"
        }
      },
      {
        "topic": "general",
        "priority_class": 5,
        "when": {},
        "effective_from": "2026-09-30",
        "effective_to": null,
        "date_basis": "declaration",
        "id": "GEN-ART27-2-FOREIGN-LAB",
        "effect": "CONDITIONAL",
        "documents": [
          {
            "name": "국외시험·검사기관 시험·검사성적서",
            "category": "조건부 제출서류"
          }
        ],
        "condition_note": "별표 9 제2호다목의 정밀검사 대상 식품만 해당한다.",
        "legal_basis": [
          "수입식품안전관리 특별법 시행규칙 제27조제1항제2호"
        ],
        "source": {
          "source_id": "law_enforcement_rule_27",
          "title": "수입식품안전관리 특별법 시행규칙 제27조(수입식품등의 수입신고)",
          "url": "https://www.law.go.kr/LSW/lsInfoP.do?lsiSeq=290799&efYd=20260930",
          "publication_date": null,
          "retrieved_at": "2026-11-10T10:13:26+09:00",
          "location": "제27조(수입식품등의 수입신고) 제1항제2호",
          "quote": "「식품ㆍ의약품분야 시험ㆍ검사 등에 관한 법률」 제8조 에 따른 국외시험ㆍ검사기관이 정밀검사를 하여 발행한 시험ㆍ검사성적서( 별표 9 제2호다목에 따른 정밀검사 대상 수입식품등만 해당한다)"
        }
      },
      {
        "topic": "general",
        "priority_class": 5,
        "when": {},
        "effective_from": "2026-09-30",
        "effective_to": null,
        "date_basis": "declaration",
        "id": "GEN-ART27-3-GMO",
        "effect": "CONDITIONAL",
        "documents": [
          {
            "name": "구분유통증명서 등 유전자변형식품 관련 서류",
            "category": "조건부 제출서류"
          }
        ],
        "condition_note": "유전자변형식품등 표시대상인데 표시하지 않은 경우만 해당한다.",
        "legal_basis": [
          "수입식품안전관리 특별법 시행규칙 제27조제1항제3호"
        ],
        "source": {
          "source_id": "law_enforcement_rule_27",
          "title": "수입식품안전관리 특별법 시행규칙 제27조(수입식품등의 수입신고)",
          "url": "https://www.law.go.kr/LSW/lsInfoP.do?lsiSeq=290799&efYd=20260930",
          "publication_date": null,
          "retrieved_at": "2026-11-10T10:13:26+09:00",
          "location": "제27조(수입식품등의 수입신고) 제1항제3호",
          "quote": "다음 각 목의 어느 하나에 해당하는 서류[유전자변형식품등( 「식품위생법」 제12조의2 제1항 각 호의 어느 하나에 해당하는 생명공학기술을 활용하여 재배ㆍ육성된 농ㆍ축ㆍ수산물 등으로서 안전성 심사를 받은 식품, 이를 원재료로 제조ㆍ가공한 식품 또는 식품첨가물을 말한다. 이하 같다) 표시대상에 해당하는 식품으로서 유전자변형식품등임을 표시하지 아니한 경우만 해당한다] 가. 구분유통증명서(종자구입ㆍ생산ㆍ제조ㆍ보관ㆍ선별ㆍ운반ㆍ선적 등 취급과정에서 유전자변형식품등과 구분하여 관리하였음을 증명하는 서류를 말한다. 이하 같다) 나. 구분유통증명서와 동등한 효력이 있음을 생산국의 정부가 인정하는 증명서 다. 「식품ㆍ의약품분야 시험ㆍ검사 등에 관한 법률」 제6조 및 제8조 에 따라 지정되었거나 지정된 것으로 보는 시험ㆍ검사기관에서 발행한 유전자변형식품등 표시대상이 아님을 입증하는 시험ㆍ검사성적서"
        }
      },
