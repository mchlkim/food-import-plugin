        "source": {
          "source_id": "mfds_required_docs",
          "title": "(공지)수입식품 수입신고 시 제출해야 하는 구비서류 목록('26.8.4)",
          "url": "https://impfood.mfds.go.kr/CFCII04F02/getCntntsDetail?page=1&limit=10&cntntsView=list&cntntsSn=666431",
          "publication_date": "2026-08-04",
